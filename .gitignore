.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/
yolo-env/

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo

# Environment variables & secrets (Security safeguard)
.env
*.env
.env.*
secrets/
