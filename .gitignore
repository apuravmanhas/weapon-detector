*.key

# Operating System files
.DS_Store
Thumbs.db

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# YOLO runs & outputs
runs/
runs_detection/
output/
*.log
result*.jpg
result*.png
output*.mp4
detections*.json
